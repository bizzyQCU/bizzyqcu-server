# ==============================================================================
# BizzyQCU Server Environment Variables Template
# Copy this file to .env and fill in the required credentials.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Connection (PostgreSQL / Neon)
DATABASE_URL="postgresql://user:password@localhost:5432/bizzyqcu?schema=public"

# JWT Authentication (Required: at least 32 characters)
JWT_SECRET=replace_with_a_secure_random_key_of_at_least_32_characters

# WebAuthn Passkeys Configuration
RP_NAME="BizzyQCU"
RP_ID="localhost"
ORIGIN="http://localhost:5173"

# Email Delivery (SMTP / Gmail App Password)
# In development mode, if left blank, OTP codes will be printed to server console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="BizzyQCU Support <noreply@bizzyqcu.edu.ph>"

# Cloudinary Storage (Optional in dev, required for ID/Selfie/Product uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# PayMongo Payment Gateway (Optional in dev; test keys for Subsystem 3)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
